<Page
    x:Class="RocoPilot.Views.Windows.AutoBattleConfigPages.AutoBattleSpiritCaptureConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/DialogControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RuleAvatarStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Style="{StaticResource DialogPageRootStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE716;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Style="{StaticResource DialogTitleTextStyle}" Text="精灵捕捉名单" />
                    <TextBlock
                        Style="{StaticResource DialogDescriptionTextStyle}"
                        Text="仅用于普通战斗，且「奇遇解除操作」选择捕捉时生效。" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DialogSectionCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource DialogSectionHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE716;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource DialogSectionTitleStyle}" Text="启用精灵名单" />
                            <TextBlock
                                Style="{StaticResource DialogDescriptionTextStyle}"
                                Text="{x:Bind Editor.CapturePolicySummary, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            Width="44"
                            MinWidth="44"
                            HorizontalAlignment="Right"
                            Padding="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Editor.CapturePolicyEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <StackPanel Style="{StaticResource DialogSectionBodyStyle}" Spacing="10">
                        <CheckBox
                            Content="仅捕捉白名单内的精灵"
                            IsChecked="{x:Bind Editor.CaptureOnlyListedSpirits, Mode=TwoWay}"
                            IsEnabled="{x:Bind Editor.CapturePolicyOptionsEnabled, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="奇遇解除后识别敌方精灵：白名单内的捕捉，黑名单内的直接击败；仅捕捉白名单开启时，其余精灵不捕捉，否则其余按血脉筛选。精灵名识别失败时默认捕捉；出异色时仍会暂停所有自动操作。"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Name="SpiritSearchBox"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind Editor.CapturePolicyOptionsEnabled, Mode=OneWay}"
                                PlaceholderText="搜索精灵名，如：吸泥鸥"
                                QueryIcon="Find"
                                TextChanged="SpiritSearchBox_TextChanged"
                                QuerySubmitted="SpiritSearchBox_QuerySubmitted"
                                SuggestionChosen="SpiritSearchBox_SuggestionChosen">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Image
                                                    Width="26" Height="26"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Source="{Binding AvatarImage}"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                            <ComboBox
                                x:Name="NewRuleActionBox"
                                Grid.Column="1"
                                MinWidth="88"
                                SelectedIndex="0"
                                VerticalAlignment="Stretch">
                                <ComboBoxItem Content="捕捉" />
                                <ComboBoxItem Content="击败" />
                            </ComboBox>
                            <Button
                                Grid.Column="2"
                                Click="AddButton_Click"
                                Content="添加"
                                IsEnabled="{x:Bind Editor.CapturePolicyOptionsEnabled, Mode=OneWay}"
                                Style="{StaticResource DialogButtonStyle}" />
                        </Grid>

                        <ListView
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{x:Bind Editor.CapturePolicyOptionsEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind Editor.CaptureRuleItems, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RuleAvatarStyle}">
                                                <Image
                                                    Width="36" Height="36"
                                                    Margin="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Source="{Binding AvatarImage}"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding SpiritName}" />
                                            <Border
                                                Grid.Column="2"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                CornerRadius="6">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
                                                </Border.Background>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{Binding ActionDisplay}" />
                                            </Border>
                                            <Button
                                                Grid.Column="3"
                                                MinWidth="0" MinHeight="0"
                                                Padding="6"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="RemoveButton_Click"
                                                Content="&#xE74D;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="13"
                                                Tag="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyListHint"
                            HorizontalAlignment="Center"
                            Spacing="6">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8F1;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="暂无名单条目：搜索上方精灵名添加" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
